<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="debug" name="mancala" packages="">
    <Appenders>
        <File name="File" fileName="./logs/mancala.log" append="true">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss} %-5p %m%n</Pattern>
            </PatternLayout>
        </File>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
